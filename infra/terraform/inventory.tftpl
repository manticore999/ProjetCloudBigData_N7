# Généré par Terraform — ne pas éditer à la main.
[master]
${master.name} ansible_host=${master.public_ip} private_ip=${master.private_ip}

[workers]
%{ for w in workers ~}
${w.name} ansible_host=${w.public_ip} private_ip=${w.private_ip}
%{ endfor ~}

[cluster:children]
master
workers

[cluster:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${ssh_private_key_path}
ansible_python_interpreter=/usr/bin/python3
machine_type_master=${machine_type_master}
machine_type_worker=${machine_type_worker}
