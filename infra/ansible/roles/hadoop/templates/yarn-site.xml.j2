<?xml version="1.0" encoding="UTF-8"?>
<!-- {{ ansible_managed }} -->
<configuration>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>{{ master_host }}</value>
  </property>
  <property>
    <name>yarn.resourcemanager.webapp.address</name>
    <value>0.0.0.0:8088</value>
  </property>

  <!-- Ressources d'un worker -->
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>{{ yarn_nm_memory_mb }}</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>{{ yarn_nm_vcores }}</value>
  </property>
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>512</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>{{ yarn_nm_memory_mb }}</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-vcores</name>
    <value>{{ yarn_nm_vcores }}</value>
  </property>

  <!-- Fichiers de shuffle et de spill Spark : sur le disque /data -->
  <property>
    <name>yarn.nodemanager.local-dirs</name>
    <value>{{ data_mount }}/yarn/local</value>
  </property>
  <property>
    <name>yarn.nodemanager.log-dirs</name>
    <value>{{ data_mount }}/yarn/logs</value>
  </property>

  <!-- Pas de kill de conteneur sur dépassement mémoire virtuelle/physique :
       un run tué au milieu d'une campagne est pire qu'un léger dépassement. -->
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>yarn.nodemanager.pmem-check-enabled</name>
    <value>false</value>
  </property>

  <property>
    <name>yarn.log-aggregation-enable</name>
    <value>true</value>
  </property>
</configuration>
